{
  "expo": {
    "name": "Folio",
    "slug": "folio",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "folio",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08080B",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": false
    },
    "android": {
      "package": "dev.andreimanu.folio",
      "adaptiveIcon": {
        "backgroundColor": "#08080B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "versionCode": 1
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "themeColor": "#08080B",
      "backgroundColor": "#08080B"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08080B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "dark",
          "enforceContrast": false
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "0105c1c2-4a0e-4857-9d9c-de8708c13fda"
      }
    },
    "owner": "andreixmanu",
    "updates": {
      "url": "https://u.expo.dev/0105c1c2-4a0e-4857-9d9c-de8708c13fda"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
