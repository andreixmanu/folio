# Base URL of the Folio API (Cloudflare Worker in ./worker). No secrets here: it's public.
# Dev on a phone via Expo Go: use the Expo dev server's /api proxy (see metro.config.js),
# e.g. https://<your-tunnel>.exp.direct/api, or http://<LAN-IP>:8081/api.
# Web on this machine: http://localhost:8787 (wrangler dev) also works.
# If unset, the app derives `<expo dev server>/api` automatically in development.
EXPO_PUBLIC_API_URL=

# Deve coincidere con APP_CHAT_TOKEN in worker/.dev.vars; header X-Folio-Token su /chat e /wallets.
EXPO_PUBLIC_CHAT_TOKEN=

# Budget feed. Leave unset to use the built-in mock (Jest and Expo Go stay on the mock).
# Set to remote to read open-banking accounts from the Worker /bank/* routes.
# EXPO_PUBLIC_BUDGET_SOURCE=remote
